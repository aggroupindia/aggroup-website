
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins', sans-serif;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#f7fbff;
    color:#222;
}


/* HEADER */

header{
    background:linear-gradient(135deg,#0066a6,#00b4d8);
    color:white;
    min-height:650px;
}


/* NAVBAR */

nav{
    width:90%;
    margin:auto;
    padding:20px 0;
    display:flex;
    justify-content:space-between;
    align-items:center;
}


/* LOGO */

.logo{
    display:flex;
    align-items:center;
    gap:12px;
}


.logo img{
    width:60px;
    height:60px;
    object-fit:contain;
    background:white;
    border-radius:50%;
}


.logo h2{
    color:white;
    font-size:28px;
}


/* MENU */

nav ul{
    display:flex;
    list-style:none;
    gap:30px;
}


nav ul li a{
    color:white;
    text-decoration:none;
    font-size:17px;
    font-weight:500;
}


nav ul li a:hover{
    color:#ffe66d;
}



/* HERO */

.hero{
    width:90%;
    margin:auto;
    padding:90px 0;
}


.hero-text{
    max-width:750px;
}


.hero h1{
    font-size:48px;
    line-height:1.2;
    margin-bottom:20px;
}


.hero p{
    font-size:20px;
    line-height:1.6;
    margin-bottom:35px;
}



/* BUTTONS */

.btn,
.btn2{
    display:inline-block;
    padding:14px 32px;
    border-radius:30px;
    text-decoration:none;
    font-weight:600;
    margin-right:15px;
    transition:0.3s;
}


.btn{
    background:white;
    color:#0066a6;
}


.btn2{
    background:#25D366;
    color:white;
}


.btn:hover,
.btn2:hover{
    transform:translateY(-5px);
}
/* Fix Logo Size */

.logo img{
    width:60px !important;
    height:60px !important;
    max-width:60px !important;
    object-fit:contain !important;
}


header img{
    width:60px !important;
    height:60px !important;
}

/* COMMON CONTAINER */

.container{
    width:90%;
    margin:auto;
}


/* ABOUT SECTION */

.about{
    padding:70px 0;
    background:white;
    text-align:center;
}


.about h2,
.products h2,
.why-us h2,
.contact h2,
.map h2{
    font-size:36px;
    color:#0066a6;
    margin-bottom:25px;
}


.about p{
    max-width:900px;
    margin:auto;
    font-size:18px;
    line-height:1.8;
    color:#555;
}



/* PRODUCTS SECTION */

.products{
    padding:70px 0;
    background:#f7fbff;
    text-align:center;
}


.product-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:30px;
    margin-top:40px;
}


.card{
    background:white;
    padding:35px 25px;
    border-radius:15px;
    box-shadow:0 10px 25px rgba(0,0,0,0.08);
    transition:0.4s;
}


.card:hover{
    transform:translateY(-10px);
}


.icon{
    font-size:45px;
    margin-bottom:15px;
}


.card h3{
    color:#0066a6;
    margin-bottom:15px;
}


.card p{
    color:#666;
    line-height:1.6;
}



/* WHY CHOOSE US */

.why-us{
    padding:70px 0;
    background:white;
    text-align:center;
}


.why-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:25px;
    margin-top:40px;
}


.why-card{
    padding:30px 20px;
    background:#f7fbff;
    border-radius:15px;
    transition:0.3s;
}


.why-card:hover{
    transform:scale(1.05);
}


.why-card h3{
    color:#0066a6;
    margin-bottom:15px;
}



/* CONTACT */

.contact{
    padding:70px 0;
    background:#f7fbff;
    text-align:center;
}


form{
    max-width:600px;
    margin:auto;
}


form input,
form textarea{

    width:100%;
    padding:15px;
    margin:10px 0;
    border:1px solid #ddd;
    border-radius:8px;
    font-size:16px;

}


form textarea{
    height:130px;
}


form button{

    background:#0066a6;
    color:white;
    border:none;
    padding:15px 40px;
    border-radius:30px;
    font-size:16px;
    cursor:pointer;

}


form button:hover{

    background:#004b7a;

}



/* MAP */

.map{
    text-align:center;
    padding:60px 0;
    background:white;
}



/* FOOTER */

footer{

    background:#003b73;
    color:white;
    text-align:center;
    padding:40px 20px;

}


footer h3{

    font-size:30px;
    margin-bottom:15px;

}


footer p{

    margin:8px 0;

}



/* WHATSAPP BUTTON */

.whatsapp{

    position:fixed;
    right:25px;
    bottom:25px;
    width:55px;
    height:55px;
    background:#25D366;
    color:white;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:28px;
    text-decoration:none;
}



/* MOBILE RESPONSIVE */

@media(max-width:768px){


nav{
    flex-direction:column;
    gap:20px;
}


nav ul{
    flex-direction:column;
    text-align:center;
}


.hero h1{
    font-size:32px;
}


.hero p{
    font-size:16px;
}


.product-grid{

    grid-template-columns:1fr;

}


.why-grid{

    grid-template-columns:1fr;

}


.logo h2{

    font-size:22px;

}

/* PROFESSIONAL HEADER UPDATE */

nav{
    position:sticky;
    top:0;
    z-index:1000;
    background:rgba(0,102,166,0.95);
    border-radius:0 0 15px 15px;
}


.logo img{
    width:70px !important;
    height:70px !important;
    padding:5px;
}


nav ul li a{
    padding:8px 15px;
    border-radius:20px;
}

nav ul li a:hover{
    background:white;
    color:#0066a6;
}
/* DIRECTOR MESSAGE SECTION */

.director{
    padding:80px 0;
    background:white;
}


.director-content{
    width:90%;
    margin:auto;
    display:flex;
    align-items:center;
    gap:50px;
}


.director-image{
    flex:1;
    text-align:center;
}


}


.director-text{
    flex:2;
}


.director-text h2{

    color:#0066a6;
    font-size:36px;
    margin-bottom:15px;

}


.director-text h3{

    font-size:22px;
    color:#333;
    margin-bottom:20px;

}


.director-text p{

    color:#555;
    font-size:17px;
    line-height:1.8;
    margin-bottom:15px;

}


.director-name{

    color:#0066a6 !important;
    font-size:20px !important;

}

.hero-text h1{
    animation: slideUp 1.2s ease;
}


.hero-text p{
    animation: slideUp 1.5s ease;
}


.hero-text .btn,
.hero-text .btn2{
    animation: slideUp 1.8s ease;
}


.card,
.why-card,
.director-content{
    animation: fadeUp 1.5s ease;
}



@keyframes slideUp{

from{
    opacity:0;
    transform:translateY(50px);
}

to{
    opacity:1;
    transform:translateY(0);
}

}



@keyframes fadeUp{

from{
    opacity:0;
    transform:translateY(30px);
}

to{
    opacity:1;
    transform:translateY(0);
}

}
